[Unit]
Description=GMC v2 — AI-First Group Mediclaim Underwriting Platform (Opexminds DS)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/gmc-v2/publish/web
ExecStart=/home/ubuntu/.dotnet/dotnet /home/ubuntu/gmc-v2/publish/web/GmcV2.Web.dll --urls http://127.0.0.1:5062
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment="GMCV2_SQL=Server=127.0.0.1,1433;Database=GMCv2;User Id=sa;Password=Gmc0pex!2026;TrustServerCertificate=True"
Restart=always
RestartSec=3
KillSignal=SIGINT
SyslogIdentifier=gmc-v2

[Install]
WantedBy=multi-user.target
